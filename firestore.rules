rules_version = '2';
// Inazuma Gold · reglas de la base de datos
// Pégalas en Firebase → Firestore Database → Reglas → Publicar.
// Cada jugador solo puede leer y guardar SU partida, y cada guardado
// tiene que ser la versión siguiente (así dos móviles no se pisan).
service cloud.firestore {
  match /databases/{database}/documents {
    // Liga online: cada jugador publica SU equipo (para que otros se enfrenten a él con la IA) y cualquiera con sesión puede leer los de su división.
    match /liga/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().size() < 12
                   && request.resource.data.ps.size() == 5;
    }
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rev == 1;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rev == resource.data.rev + 1;
    }
  }
}
